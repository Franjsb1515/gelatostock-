{
  "name": "appgelatostock",
  "version": "0.45.0",
  "private": true,
  "description": "Prototipo local de inventario y compras para gelateria",
  "main": "src/desktop.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "node src/server.cjs",
    "test": "npm run build && node --test tests/*.test.cjs",
    "package:win": "npm run build && node scripts/package.cjs",
    "test:desktop": "node scripts/desktop-smoke.cjs",
    "session:new": "node scripts/new-session.cjs",
    "format:check": "prettier --check \"core/**/*.ts\" \"src/**/*.{js,cjs,css,html}\" \"tests/*.cjs\" \"scripts/*.cjs\"",
    "build": "tsc -p tsconfig.json && node scripts/build-guide.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prestart": "npm run build",
    "predev": "npm run build",
    "package:mac": "npm run build && node scripts/package.cjs",
    "installer:win": "node scripts/installer.cjs",
    "icon": "node scripts/make-icon.cjs",
    "installer:mac": "node scripts/installer.cjs"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.19",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@tesseract.js-data/spa": "1.0.0",
    "qrcode": "1.5.4",
    "tesseract.js": "7.0.0",
    "unpdf": "^1.8.1",
    "whatsapp-web.js": "1.34.7",
    "zod": "4.5.4"
  },
  "overrides": {
    "puppeteer": "25.10.0",
    "sharp": "0.35.0",
    "adm-zip": "0.6.0"
  }
}

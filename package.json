{
  "name": "appgelatostock",
  "version": "0.1.0",
  "private": true,
  "description": "Prototipo local de inventario y compras para gelateria",
  "main": "src/desktop.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "node src/server.cjs",
    "test": "node --test tests/*.test.cjs",
    "package:win": "node scripts/package.cjs",
    "test:desktop": "node scripts/desktop-smoke.cjs",
    "session:new": "node scripts/new-session.cjs",
    "format:check": "prettier --check \"src/**/*.{js,cjs,css,html}\" \"tests/*.cjs\" \"scripts/*.cjs\""
  },
  "devDependencies": {
    "@playwright/cli": "0.1.19",
    "electron": "44.2.0",
    "prettier": "3.9.6"
  }
}
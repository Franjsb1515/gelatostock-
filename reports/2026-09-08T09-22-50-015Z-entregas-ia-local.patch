+.delivery-table td {
+  padding: 16px 24px;
+  border-bottom: 1px solid #edf0e7;
+}
+.delivery-table small,
+.delivery-next small {
+  display: block;
+  color: #62705a;
+  margin-top: 5px;
+}
+.delivery-next {
+  display: flex;
+  justify-content: space-between;
+  gap: 20px;
+  align-items: center;
+  padding: 20px 24px;
+  background: #fafbf6;
+  font-size: 13px;
+}
+.delivery-next strong {
+  font-weight: 500;
+}
+.table-scroll {
+  overflow: auto;
+}
+.ai-result {
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+  line-height: 1.7;
+  padding: 20px;
+  background: #f0f4ea;
+  border-radius: 12px;
+}
+.ai-editor {
+  min-height: 180px;
+  resize: vertical;
+  width: 100%;
+}
+@media (max-width: 1100px) {
+  .tracking-intro {
+    grid-template-columns: 1fr;
+  }
+  .delivery-next {
+    align-items: start;
+    flex-direction: column;
+  }
+  .delivery-table td,
+  .delivery-table th {
+    padding: 12px;
+  }
+}
+
+.delivery-next {
+  color: #46563d;
+  margin: 0;
+  max-width: none;
+}
+.ai-result blockquote {
+  margin: 12px 0;
+  padding-left: 14px;
+  border-left: 3px solid #69815b;
+}

+// Minimal, safe Markdown for the guide: headings, paragraphs, lists. Everything escaped.
+function guideHtml(md) {
+  const lines = md.split(/\r?\n/);
+  let html = "",
+    list = false;
+  const close = () => {
+    if (list) html += "</ul>";
+    list = false;
+  };
+  for (const raw of lines) {
+    const line = raw.trim();
+    if (!line) {
+      close();
+      continue;
+    }
+    if (line.startsWith("# ")) {
+      close();
+      continue;
+    }
+    if (line.startsWith("## ")) {
+      close();
+      html += `<h2 id="guia-${esc(
+        line
+          .slice(3)
+          .toLowerCase()
+          .replace(/[^a-z0-9]+/g, "-"),
+      )}">${esc(line.slice(3))}</h2>`;
+      continue;
+    }
+    if (line.startsWith("- ")) {
+      if (!list) html += "<ul>";
+      list = true;
+      html += `<li>${esc(line.slice(2))}</li>`;
+      continue;
+    }
+    close();
+    html += `<p>${esc(line)}</p>`;
+  }
+  close();
+  return html;

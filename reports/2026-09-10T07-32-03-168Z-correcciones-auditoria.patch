+  const local = new Date(at);
+  const tomorrow = new Date(
+    local.getFullYear(),
+    local.getMonth(),
+    local.getDate() + 1,
+  );
+  assert.equal(resolveDate("llega mañana", at)?.date, localDate(tomorrow));

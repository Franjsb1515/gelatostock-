+    Math.round(((0.5 * 4.8 + 0.2 * 3) / 0.7) * 10) / 10,
+  );
+  assert.equal(b.flags.find((f) => f.key === "fat").status, "high");
+  assert.equal(b.flags.find((f) => f.key === "sugars").status, "low");

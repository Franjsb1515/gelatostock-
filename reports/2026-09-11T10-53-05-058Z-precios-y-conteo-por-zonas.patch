+    product: "p2",
+    name: "Leche entera",
+    detail: "",
+    min: 12,
+    target: 30,
+    pack: 6,
+    supplier: "s2",
+  };
+  let s = apply(seed(), { ...base, price: 690 });
+  assert.equal(s.prices.length, 0);
